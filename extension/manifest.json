{
  "manifest_version": 3,
  "name": "Browser Agent Bridge",
  "version": "0.1.0",
  "description": "Bridges your real Chrome profile to a local MCP server for AI agent control.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "dist/sw.js", "type": "module" },
  "permissions": ["debugger", "tabs", "scripting", "activeTab", "alarms", "storage", "offscreen", "webRequest", "declarativeNetRequestWithHostAccess", "webNavigation", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_page": "options.html",
  "action": { "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }, "default_title": "Browser Agent Bridge" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+K" } } }
}
